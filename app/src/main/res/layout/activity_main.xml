<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B0B0B0"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/phase_1_title"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <!-- What the phone heard and what it answered. Misheard Thai is the
             most common failure in the voice path and this is where it shows. -->
        <TextView
            android:id="@+id/transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="#D0D0D0"
            android:textSize="15sp" />

        <!-- Device Owner / lock task state. The only way to read provisioning
             state from the phone itself, and what the manual test steps check. -->
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textColor="#808080"
            android:textSize="13sp" />

        <!-- Every stage of the voice path, so a failure names itself. -->
        <TextView
            android:id="@+id/voice_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="#707070"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- The escape hatch. Transparent and unlabelled on purpose; 96dp is a
         corner you can hit repeatedly without looking, and small enough that
         it is not in the way of anything phase 5 puts on this screen. -->
    <View
        android:id="@+id/exit_corner"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="@null" />

</FrameLayout>
