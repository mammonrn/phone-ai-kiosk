<?xml version="1.0" encoding="utf-8"?>
<!--
  The kiosk screen: a 1995-flavoured desktop, portrait, read from about 20 cm.

  exit_corner IS STILL HERE, and must stay. It is the only way off this device
  without a factory reset (ten taps, bottom right), and a redesign that quietly
  dropped it would strand the phone. The big clock and its date are gone: the
  time is in the taskbar, bottom right, and the top window is the Google Home
  menu.

  THE DISTANCE CHANGED, AND WITH IT EVERY SIZE IN THIS FILE. The first version
  was set for two metres: a 64sp clock, nothing with a number in it under 20sp.
  Poom reads this the way anyone reads a phone — in the hand, a hand's length
  away — and at 20 cm that scale is a motorway sign. On this device (720x1600
  at 300 dpi, so 384dp wide) a 64sp clock was 4 cm of glass for eight digits,
  and the gold price wrapped its own freshness note onto a second line.
  Everything here is now set for arm's length: 28sp for the hero, 14-15sp for
  numbers you read, 11sp for labels, 8sp for diagnostics.

  TWO FONTS, BOTH SIL OFL, BOTH IN THIS REPOSITORY. Press Start 2P carries the
  digits and Latin; IBM Plex Sans Thai Looped carries Thai and the small print.
  Neither is a Microsoft font and neither is an icon pack — the chrome is still
  layer-list shapes and the icons are still vectors drawn from squares. See
  NOTICE for where the two faces come from and what their licence asks for.
  The mixing inside one line is done in code: see ui/RetroType.kt.

  WHAT IS BIGGEST IS WHAT MATTERS: what Jarvis is doing and what it heard, then
  the numbers, then their labels, then the diagnostics.

  THE SPARE HEIGHT IS SHARED, NOT HOARDED. Smaller type left about a third of
  the screen over, and the Jarvis window — the only one with a weight — took
  all of it, so the kiosk sat there with a grey box the size of a postcard and
  one line of text in the middle of it. Every window now carries a weight and
  gets a share: one each for the four that hold data, two for Jarvis, which
  still needs the most because it is the one that fills up when somebody talks
  to it. Inside each window the sunken panel carries the same weight again, so
  the share lands in the panel and the content centres in it, rather than
  pooling as dead grey under the last line.

  Those inner panels are wrap_content AND weighted on purpose. A child of a
  wrap_content LinearLayout that asks for 0dp measures to nothing; asking for
  wrap_content and a weight measures to its content first and then grows when
  the parent is re-measured with the share it was given.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/retro_desktop">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="7dp">

        <!-- ================================================= google home window -->
        <!-- Where the big clock was. The time lives in the taskbar now, bottom
             right, and only there; this space is the Google Home menu.

             A PLACEHOLDER THIS PHASE. The button is real and tappable and says
             it is not switched on yet — see home/HomeControl, which is the one
             place a real implementation will go in the last phase. Nothing
             behind it talks to Google. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/retro_raised"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/retro_titlebar"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_pixel_home"
                    android:contentDescription="@string/window_home" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/window_home"
                    android:textColor="@color/retro_title_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plex_thai" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/retro_sunken"
                android:layout_marginTop="3dp"
                android:padding="7dp">

                <!-- A raised 1995 button, the one control on this screen that
                     looks pressable, because it is. -->
                <TextView
                    android:id="@+id/home_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/retro_raised"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/home_button"
                    android:textColor="@color/retro_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plex_thai" />

                <TextView
                    android:id="@+id/home_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="@string/home_not_connected"
                    android:textColor="@color/retro_dim"
                    android:textSize="11sp"
                    android:fontFamily="@font/plex_thai" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================================================== weather window -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/retro_raised"
            android:layout_marginTop="7dp"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/retro_titlebar"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <!-- Swapped for the moon after dark — see MainActivity, which
                     reads the same `is_day` the broker chose the word from, so
                     the picture and the word cannot disagree with each other. -->
                <ImageView
                    android:id="@+id/weather_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_pixel_sun"
                    android:contentDescription="@string/window_weather" />

                <!-- The place name is appended here at runtime, so this one can
                     grow. One line, cut at the end if it has to be: a title bar
                     that wraps stops looking like a title bar. -->
                <TextView
                    android:id="@+id/weather_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/window_weather"
                    android:textColor="@color/retro_title_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plex_thai" />
            </LinearLayout>

            <TextView
                android:id="@+id/weather_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:background="@drawable/retro_sunken"
                android:layout_marginTop="3dp"
                android:padding="7dp"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/retro_text"
                android:textSize="14sp"
                android:fontFamily="@font/plex_thai"
                android:text="@string/data_loading" />
        </LinearLayout>

        <!-- ======================================================= gold window -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/retro_raised"
            android:layout_marginTop="7dp"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/retro_titlebar"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_pixel_gold"
                    android:contentDescription="@string/window_gold" />

                <!-- Gains " · เทียบครั้งก่อน" at runtime once there is a
                     percentage beside the prices, and loses it again if there
                     is not. One line, cut at the end if it has to be. -->
                <TextView
                    android:id="@+id/gold_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/window_gold"
                    android:textColor="@color/retro_title_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plex_thai" />
            </LinearLayout>

            <TextView
                android:id="@+id/gold_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:background="@drawable/retro_sunken"
                android:layout_marginTop="3dp"
                android:padding="7dp"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/retro_text"
                android:textSize="15sp"
                android:fontFamily="@font/plex_thai"
                android:text="@string/data_loading" />
        </LinearLayout>

        <!-- ===================================================== crypto window -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/retro_raised"
            android:layout_marginTop="7dp"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/retro_titlebar"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_pixel_coin"
                    android:contentDescription="@string/window_crypto" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/window_crypto"
                    android:textColor="@color/retro_title_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plex_thai" />
            </LinearLayout>

            <!-- TWO COLUMNS, each coin two lines, dealt two and two: a coin on
                 one line is about 230dp in the pixel face. Not one TextView with
                 spaces between the columns: the pixel font is monospaced and the
                 Thai font beside it is not, so nothing would line up.

                 SIZED TO THE TEXT, NOT TO HALF THE WINDOW. Each column used to
                 be a weighted half, which parked the right-hand pair at the
                 window's midline however short the numbers were and left a
                 gutter you could drive through. Now both wrap their content,
                 sit together in the middle with a fixed gap, and the type scale
                 is untouched. The widest column today is "BTC +0.13%" at about
                 130dp, so two of them and the gap are well inside 350dp. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/retro_sunken"
                android:layout_marginTop="3dp"
                android:padding="7dp">

                <TextView
                    android:id="@+id/crypto_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="1dp"
                    android:textColor="@color/retro_text"
                    android:textSize="15sp"
                    android:fontFamily="@font/plex_thai"
                    android:text="@string/data_loading" />

                <TextView
                    android:id="@+id/crypto_body_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:lineSpacingExtra="1dp"
                    android:textColor="@color/retro_text"
                    android:textSize="15sp"
                    android:fontFamily="@font/plex_thai" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================================================== jarvis window -->
        <!-- Second only to the clock, and the one window that grows: it takes
             whatever the four above leave behind. That is deliberate. The
             question "is it listening, and did it hear me right" is the one
             thing on this screen you actually stand in front of. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:background="@drawable/retro_raised"
            android:layout_marginTop="7dp"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/retro_titlebar"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_pixel_jarvis"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:id="@+id/jarvis_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/jarvis_ready"
                    android:textColor="@color/retro_title_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plex_thai" />
            </LinearLayout>

            <TextView
                android:id="@+id/transcript"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/retro_sunken"
                android:layout_marginTop="3dp"
                android:padding="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/retro_text"
                android:textSize="15sp"
                android:fontFamily="@font/plex_thai"
                android:text="@string/kiosk_prompt" />

            <!-- Diagnostics, deliberately small and at the bottom: useful with a
                 phone in your hand, invisible from across the room. Carries no
                 token and no key — see VoiceState.statusLine. -->
            <TextView
                android:id="@+id/voice_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/retro_dim"
                android:textSize="8sp"
                android:fontFamily="@font/plex_thai" />
        </LinearLayout>

        <!-- ========================================================== taskbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/retro_raised"
            android:gravity="center_vertical"
            android:layout_marginTop="7dp"
            android:padding="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/retro_raised"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/taskbar_button"
                android:textColor="@color/retro_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/plex_thai" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textColor="@color/retro_dim"
                android:textSize="8sp"
                android:fontFamily="@font/plex_thai" />

            <!-- THE ONLY CLOCK ON THE SCREEN, bottom right, 12-hour with AM/PM
                 as Poom asked. The date stays with it, a size down: it was on
                 the big clock that this phase removed, and a kiosk that shows
                 the time but not the day has lost something it had. Sits under
                 exit_corner, which is transparent and takes the taps; nothing
                 here is clickable, so nothing competes with the way out. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:background="@drawable/retro_sunken"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/taskbar_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/retro_text"
                    android:textSize="11sp"
                    android:fontFamily="@font/press_start_2p" />

                <TextView
                    android:id="@+id/taskbar_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/retro_dim"
                    android:textSize="8sp"
                    android:fontFamily="@font/plex_thai" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      THE WAY OFF THIS DEVICE. Ten taps in the bottom-right corner.

      Invisible on purpose and last in the file so it sits above everything: a
      Device Owner in lock task mode cannot be left any other way without a
      factory reset. Do not move it, do not shrink it, and do not put anything
      clickable under it.
    -->
    <View
        android:id="@+id/exit_corner"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|end"
        android:background="@android:color/transparent"
        android:contentDescription="@null" />
</FrameLayout>
