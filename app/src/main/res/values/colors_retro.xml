    <color name="amp_bar_high">#FFE05000</color>
    <color name="amp_select">#FF1E3A8C</color>
    <!-- 0.56.0: the video player's panel — brushed silver and a teal read-out. -->
    <color name="dvd_silver">#FFC8CCD4</color>
    <color name="dvd_silver_light">#FFF2F4F8</color>
