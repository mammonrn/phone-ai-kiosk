<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Phone AI Kiosk</string>
    <!-- What the person standing in front of the kiosk is told to do.
         The wake word is English because the model is openWakeWord's
         "hey_jarvis"; the assistant answers in Thai. -->
    <string name="kiosk_prompt">พูด Hey Jarvis แล้วถามได้เลย</string>

    <string name="yes">yes</string>
    <string name="no">no</string>
    <string name="on">on</string>
    <string name="off">off</string>

    <string name="status_line">owner=%1$s  lock=%2$s  awake=%3$s  token=%4$s  taps=%5$d/%6$d</string>
    <string name="lock_failed">Could not enter lock task mode: %1$s</string>
    <string name="no_other_launcher">No other home app on this device — nothing to hand the screen to.</string>

    <string name="device_admin_label">Phone AI Kiosk</string>
    <string name="device_admin_description">Keeps this device on the kiosk screen.</string>

    <string name="voice_channel">Kiosk microphone</string>
    <string name="voice_notification">จาร์วิสกำลังฟังอยู่</string>
    <string name="wake_hint">พูด \"Hey Jarvis\" เพื่อเริ่ม</string>

    <!-- Window titles on the kiosk screen. -->
    <string name="window_home">Google Home</string>
    <string name="home_button">เปิดเมนู Google Home</string>
    <!-- Under the button until it is tapped. -->
    <string name="home_not_connected">ยังไม่ได้เชื่อมต่อ</string>
    <!-- What a tap says, this phase. Nothing is connected behind the button. -->
    <string name="home_disabled">ยังไม่เปิดใช้งาน · จะเชื่อมต่อในเฟสสุดท้าย</string>
    <!-- Title bar of the gold window when the broker sends the purity. The
         WORD is there on purpose: the body carries a price move that is also a
         percentage, and the two must not be read as one another. -->
    <string name="gold_purity">ความบริสุทธิ์ %1$s%%</string>
    <string name="window_weather">อากาศ</string>
    <!-- The sun line under the weather: a word as well as the icon, so the
         meaning is not carried by a picture alone. -->
    <string name="sunrise">พระอาทิตย์ขึ้น</string>
    <string name="sunset">พระอาทิตย์ตก</string>
    <string name="sunrise_at">ขึ้น %1$s</string>
    <string name="sunset_at">ตก %1$s</string>
    <string name="window_gold">ราคาทอง</string>
    <string name="window_crypto">คริปโต</string>
    <string name="taskbar_button">จาร์วิส</string>
    <string name="jarvis_button_description">กดเพื่อถามจาร์วิส</string>
    <string name="battery_description">แบตเตอรี่</string>

    <!-- The weather window's title when the position is known but its name is
         not: a reverse lookup that failed, or somewhere with no province in
         OpenStreetMap. Honest about both halves — it knows where it is, it
         just cannot name it — and never a coordinate. -->
    <string name="place_unknown">ตำแหน่งปัจจุบัน</string>

    <string name="data_loading">กำลังโหลด…</string>
    <!-- Shown in a panel whose source failed. Short: it shares a box with the
         last good value, which matters more than the reason. -->
    <string name="data_unavailable">ข้อมูลไม่พร้อม</string>

    <string name="jarvis_ready">จาร์วิส · พร้อมฟัง</string>
