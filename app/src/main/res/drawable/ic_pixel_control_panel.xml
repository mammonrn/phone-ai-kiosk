<?xml version="1.0" encoding="utf-8"?>
<!-- Our own pixel art: a small panel with two slider knobs, on the project's
     16x16 grid (DESIGN.md, "Icons"). Not Microsoft's Control Panel icon — a
     plain "settings panel" drawn from squares. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="16" android:viewportHeight="16">
    <!-- the panel, raised: light top-left, shade bottom-right -->
    <path android:fillColor="#C0C0C0" android:pathData="M1,2h14v12h-14z" />
    <path android:fillColor="#FFFFFF" android:pathData="M1,2h14v1h-14z M1,2h1v12h-1z" />
    <path android:fillColor="#404040" android:pathData="M1,13h14v1h-14z M14,2h1v12h-1z" />
    <!-- two slider tracks -->
    <path android:fillColor="#000000" android:pathData="M4,5h8v1h-8z M4,10h8v1h-8z" />
    <!-- their knobs -->
    <path android:fillColor="#000080" android:pathData="M9,4h2v3h-2z M5,9h2v3h-2z" />
</vector>
