<!-- Our own pixel art (0.62.0): a stopwatch for the timer app — a gold crown button
     on top and one at the side, a round grey case in steps, a white face and two
     black hands. Grey rather than navy so it shows on the navy title bar as well as
     on the grey Control Panel. 16x16, rectangles only, four colours. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="16" android:viewportHeight="16">
    <!-- the crown and the side button -->
    <path android:fillColor="#FFD700" android:pathData="M6,0h4v1h-4z M7,1h2v1h-2z M12,1h2v1h-2z M13,2h1v1h-1z" />
    <!-- the case -->
    <path android:fillColor="#808080" android:pathData="M5,2h6v1h-6z M3,3h10v1h-10z M2,4h12v1h-12z
        M1,5h14v6h-14z M2,11h12v1h-12z M3,12h10v1h-10z M5,13h6v1h-6z" />
    <!-- the face -->
    <path android:fillColor="#FFFFFF" android:pathData="M4,4h8v1h-8z M3,5h10v6h-10z M4,11h8v1h-8z" />
    <!-- the hands: to 12 and to 2 -->
    <path android:fillColor="#000000" android:pathData="M7,5h1v4h-1z M8,7h2v1h-2z M10,6h1v1h-1z" />
</vector>
