    android:viewportWidth="16" android:viewportHeight="16">
    <!-- roof, stepped -->
    <path android:fillColor="#B03A2E" android:pathData="M7,2h2v1h-2z" />
    <path android:fillColor="#B03A2E" android:pathData="M6,3h4v1h-4z" />
    <path android:fillColor="#B03A2E" android:pathData="M5,4h6v1h-6z" />
