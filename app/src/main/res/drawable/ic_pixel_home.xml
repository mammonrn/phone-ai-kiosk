    <path android:fillColor="#B03A2E" android:pathData="M3,6h10v1h-10z" />
    <!-- walls -->
    <path android:fillColor="#FFFFFF" android:pathData="M4,7h8v7h-8z" />
    <!-- door and window -->
    <path android:fillColor="#000080" android:pathData="M7,10h2v4h-2z" />
    <path android:fillColor="#008080" android:pathData="M5,8h2v2h-2z" />
