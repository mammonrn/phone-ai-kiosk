<?xml version="1.0" encoding="utf-8"?>
<!--
  Our own pixel art, drawn on a 16x16 grid as vector rectangles — the same grid
  and the same rule as ic_pixel_sun, which this stands in for after dark.

  Every icon in this app is made here, from squares, for one reason: an icon
  pack is a licence to check and a dependency to keep, and a kiosk needs five
  small pictures. Nothing is traced from or based on anyone else's artwork.

  The crescent is the set of cells inside one circle and outside another, worked
  out on the grid and written down as one rectangle per run of pixels, so it
  steps the way an 8-bit sprite steps rather than being a smooth curve pretending
  to be one. Two stars beside it, one cell each, because a lone crescent at 13dp
  reads as a bracket.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="16" android:viewportHeight="16">
    <!-- the crescent -->
    <path android:fillColor="#FFE8A0"
        android:pathData="M6,2h3v1h-3z M4,3h4v1h-4z M3,4h4v1h-4z M2,5h4v1h-4z
                          M2,6h4v1h-4z M2,7h4v1h-4z M2,8h4v1h-4z M2,9h4v1h-4z
                          M2,10h4v1h-4z M3,11h4v1h-4z M4,12h4v1h-4z M6,13h3v1h-3z" />
    <!-- two stars, on the open side so they do not crowd the curve -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M11,4h1v1h-1z M13,8h1v1h-1z M11,11h1v1h-1z" />
</vector>
