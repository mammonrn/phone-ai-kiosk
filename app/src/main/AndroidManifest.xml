<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talking to the broker, and nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The microphone, and the foreground service type that Android requires
         for holding it continuously. RECORD_AUDIO is granted by the Device
         Owner without a dialog — see MainActivity.grantMicrophoneToSelf — which
         matters because a modal permission prompt inside lock task mode is a
         modal nobody in the house can get past. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The music player (0.53.0) plays on with its screen closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      WAKE_LOCK, for one thing: "Hey Jarvis" turning a dark screen back on
      (voice/ScreenWaker). The screen goes off after five idle minutes and the
      microphone keeps listening; a wake lock with ACQUIRE_CAUSES_WAKEUP is how
      a service, rather than a touch, brings the display back. Normal
      protection level, granted at install, no dialog.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Alarms (2026-09-23). AlarmManager.setAlarmClock is the only timer Android
      promises to fire on time in Doze, and it needs an exact-alarm permission:
      USE_EXACT_ALARM on Android 13+ (granted at install, no dialog — this is a
      clock for the household), SCHEDULE_EXACT_ALARM below that. See
      alarm/AlarmScheduler.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!--
      WHERE THE KIOSK IS, TO ABOUT THREE KILOMETRES.

      COARSE AND ONLY COARSE. ACCESS_FINE_LOCATION is deliberately not here and
      should not be added: fine location is metres, and metres is which room of
      the house. The weather is not reported more finely than a kilometre, so
      there is nothing fine location would buy — see voice/KioskLocation.kt,
      which rounds even the coarse answer to two decimals before it leaves.

      Granted by the Device Owner without a dialog for the same reason
      RECORD_AUDIO is: in lock task mode a permission prompt is a modal nobody
      in the house can get past. And read back afterwards, because the grant
      call returns nothing to say whether it worked.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      THE CAMERA: the front camera for the identity check (auth/VerifyActivity), and since 0.61.0 the
      camera screen for a photo (camera/CameraActivity, Poom's basic apps).
      Open only while that window is on screen; frames are analysed in memory
      and never written or sent. Granted by the Device Owner without a dialog,
      for the same reason as the microphone. Not required: a phone without a
      front camera falls back to the pattern.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      0.42.0: the taskbar says WiFi, 4G or 5G (ui/NetworkWatch). WiFi or mobile
      needs only the ordinary network state; which mobile generation needs
      READ_PHONE_STATE, granted by the Device Owner like the microphone. Read
      for that one word; nothing about the network is logged or sent.
      The torch (Control Panel) needs no permission: setTorchMode does not.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!--
      THE FILE MANAGER (0.44.0, Poom).

      MANAGE_EXTERNAL_STORAGE is "all files access": the whole of shared
      storage, which a file manager needs and scoped storage does not give. It
      is a SPECIAL permission, an app-op, not a runtime one: a Device Owner
      cannot grant it and there is no dialog in lock task mode, so it is
      granted once over adb when the phone is provisioned:
          adb shell appops set, uid option, <package> MANAGE_EXTERNAL_STORAGE allow
      (the exact line is in TESTING.md; an XML comment cannot hold two dashes)
      Without it the file manager says so and shows that command. Even with it,
      Android/data and Android/obb stay closed (files/StorageAreas).

      THE NAS. Android 16 puts the house's local network behind a runtime
      permission (NEARBY_WIFI_DEVICES while it is opt-in, ACCESS_LOCAL_NETWORK
      from API 37). Both are runtime permissions the Device Owner grants itself
      in MainActivity, like the microphone. neverForLocation: the app does not
      learn where the phone is from WiFi scans, and says so.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
      BLUETOOTH (0.68, Poom: the Control Panel's Bluetooth page, settings/BluetoothLink).
      CONNECT: the paired devices' names and states, on/off (the device owner's
      exemption from the API 33 deprecation), pairing. SCAN: searching for a new
      device, neverForLocation - the app does not learn where the phone is from
      what it finds. Both runtime permissions, granted by the Device Owner to this
      app with no dialog, like the microphone. The two legacy ones are what API 29
      and 30 ask for instead (granted at install).
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!--
      WHY THIS BLOCK EXISTS, AND WHY IT IS ONE LINE LONG.

      From Android 11, an app that targets API 30 or higher cannot see other
      installed packages unless it says which ones it cares about. Everything
      else is filtered: PackageManager.getPackageInfo throws NameNotFound as if
      the package were absent, and — the part that actually breaks the feature —
      an Intent with setPackage() fails to resolve for the same reason.

      On the A07 that looked exactly like Google Maps not being installed:

          maps         : not-installed
          maps-package : com.google.android.apps.maps installed=false

      while `pm list packages` showed it present and running version 26.06.01.
      The phone was not wrong and the code was not wrong; the app had simply
      never been told it was allowed to look.

      ONE PACKAGE, NAMED. Not QUERY_ALL_PACKAGES, which is a permission Google
      Play restricts and which would let this app enumerate everything on the
      phone to solve a problem about one app. Not an <intent> filter for geo:
      either: that would make every maps application visible, and this kiosk
      opens Google Maps specifically — see MapsLauncher.MAPS_PACKAGE, which a
      test checks against this line.

      TWO PACKAGES NOW, each named for one action. Xiaomi Home joined for
      "ขอดูกล้อง" (CameraAppLauncher.PACKAGE, also checked by a test). Still
      named one by one, still no QUERY_ALL_PACKAGES.
    -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.xiaomi.smarthome" />
        <!-- 0.42.0: the system settings app, for the Control Panel's WiFi
             button only (settings/WifiPanel, Poom's decision). -->
        <package android:name="com.android.settings" />
        <!-- 0.65.0 (Poom): Facebook (Lite first) and Instagram behind the identity
             check, and the Play Store to install them (social/SocialVisit). -->
        <package android:name="com.facebook.lite" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.instagram.android" />
        <package android:name="com.android.vending" />
        <!-- 0.67: YouTube patched with ReVanced, behind the identity check (social/SocialVisit). -->
        <package android:name="app.revanced.android.youtube" />
    </queries>

    <!-- KioskApp registers KioskScreens: every screen of this app is tracked
         from the moment it exists, so "Hey Jarvis" can close it (0.43.0). -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".KioskApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneAiKiosk">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true">

            <!-- LAUNCHER so the app can be opened by hand before it is the
                 device owner; HOME + DEFAULT so the system resolves it as the
                 home screen, which is what puts the kiosk back after a reboot.
                 DEFAULT is required alongside HOME — without it the system
                 will not treat this as a home candidate at all. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Holds the microphone for as long as the kiosk is up.
             NOT started from BOOT_COMPLETED: Android 15 forbids launching a
             microphone foreground service from the background or from a boot
             receiver. MainActivity starts it, which is legal because this app is
             the HOME activity and the system puts it on screen at boot. -->
        <service
            android:name=".voice.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The music player (0.53.0): ExoPlayer lives here, not in the
             screen, so music plays on when Hey Jarvis closes the player
             (DESIGN.md 12). Started only from our own screens and the voice
             service, never from the background. -->
        <service
            android:name=".media.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The video player (0.56.0): the playing in a service, so the sound plays
             on when its screen closes, as the music does (DESIGN.md 12). -->
        <service
            android:name=".media.VideoService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The radio (0.61.0): plays on when its screen closes, as the music does
             (DESIGN.md 5ฏ, 12). -->
        <service
            android:name=".radio.RadioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Portrait like every screen here (DESIGN.md 1), except full screen in
             the player (0.57.0, Poom approved), which the activity asks for itself.
             A turn does not rebuild the screen: the picture and the panel stay. -->
        <activity
            android:name=".media.VideoActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <!-- The radio's screen (0.61.0), from the Control Panel. -->
        <activity
            android:name=".radio.RadioActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- The music player's screen (0.53.0), from the Control Panel. -->
        <activity
            android:name=".media.MusicActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Brings the kiosk back after an update: installing kills the process,
             which ends lock task mode, and nothing else relaunches HOME. The
             broadcast only ever reaches the package that was replaced. See
             PackageReplacedReceiver. -->
        <receiver
            android:name=".PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The Control Panel. Our own activity, so lock task mode allows it;
             not exported, so nothing but the kiosk opens it. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- The file manager (0.44.0), opened from the Control Panel. Our own
             activity, so lock task mode allows it; not exported. -->
        <activity
            android:name=".files.FilesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Google Drive (0.61.0), opened from the file manager. Our own
             activity, so lock task mode allows it; not exported. -->
        <activity
            android:name=".drive.DriveActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- The picture viewer (0.59.0), opened from the file manager: one picture,
             zoomed with two fingers. Our own activity, so lock task mode allows it. -->
        <activity
            android:name=".files.ImageViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- The voice recorder (0.61.0), opened from the Control Panel. Our own
             activity, so lock task mode allows it; not exported. -->
        <activity
            android:name=".recorder.RecorderActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 0.62.0: notes and the shopping list (notes/NotesActivity), from the Control Panel.
             Our own activity, so lock task mode allows it; not exported. -->
        <activity
            android:name=".notes.NotesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- The engineering calculator (0.52.0), opened from the Control Panel.
             Our own activity, so lock task mode allows it; not exported. -->
        <!-- 0.61.0: the phone's camera for a photo (camera/CameraActivity); open only while in front. -->
        <activity
            android:name=".camera.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".calc.CalculatorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- The identity check: face with a blink, or the pattern. Our own
             activity, so lock task mode allows it; not exported. -->
        <activity
            android:name=".auth.VerifyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- AlarmManager's call when an alarm is due. Not exported: only our own
             PendingIntent reaches it. -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- 0.62.0: the stopwatch and countdown (timer/TimerActivity) and the compass
             and level (compass/CompassActivity), from the Control Panel. Our own
             activities, so lock task mode allows them; not exported; portrait. The
             countdown's end comes to TimerReceiver, from our own PendingIntent only. -->
        <activity
            android:name=".timer.TimerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- 0.63.0: the calendar app (Poom's Google Calendar through the broker,
             behind the identity check). Ours, so lock task allows it. -->
        <!-- 0.65.0: opens Facebook or Instagram after the identity check (social/SocialVisit). -->
        <activity
            android:name=".social.SocialActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- 0.68: the Control Panel's Bluetooth page (settings/BluetoothActivity). Ours, so lock task allows it. -->
        <activity
            android:name=".settings.BluetoothActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".calendar.CalendarActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".compass.CompassActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <receiver
            android:name=".timer.TimerReceiver"
            android:exported="false" />

        <!-- The admin `dpm set-device-owner` is pointed at.
             BIND_DEVICE_ADMIN must be on the receiver, and it must be exported,
             or the system refuses to bind it and provisioning fails. -->
        <receiver
            android:name=".KioskDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">

            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
