<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay.

  android:testOnly="true" is the whole point of this file. Without it, the only
  way off a device this app has been made Device Owner of is a factory reset:
  `adb shell dpm remove-active-admin` refuses to remove a device owner unless
  the package is test-only. With it, the recovery path is one adb command.

  The cost is that a test-only APK will not install with a plain
  `adb install` — it needs `adb install -t`. That is a deliberate trade, and
  the flag must never be added to the release manifest, where it would block
  normal installation entirely.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:testOnly="true"
        tools:replace="android:testOnly">

        <!-- Debug only, by living in this source set: a receiver that can make
             the phone start recording is absent from a release build rather
             than disabled in one.

             Exported because `adb shell am broadcast` has to reach it. On a
             locked kiosk with no other apps installed that is the shell and
             nothing else; it is still the reason this is not in the release
             manifest. -->
        <receiver
            android:name="com.mammonrn.phoneaikiosk.TestTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mammonrn.phoneaikiosk.TEST_LISTEN" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_SHOW_REPLY" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_ALARM_IN" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_ASK" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_ALARM_CLEAR" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_VERIFY" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_STATS" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_RESET_STATS" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_SET_BROKER" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_SET_THRESHOLD" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_WAKE_ONLY" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_PREROLL" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_HOME" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_DIAGNOSTICS" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_STT_PROVIDER" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_SET_MARGIN" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_SET_WAIT" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_SET_SILENCE" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_AUDIO_EFFECT" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_AUDIO_SOURCE" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_MEDIA_HOLD" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_FX" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_VIDEO_ROTATE" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_HOME_CARD" />
                <action android:name="com.mammonrn.phoneaikiosk.TEST_LIGHTS_PAGE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
