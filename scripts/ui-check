#!/usr/bin/env bash
# The UI check of every screen, in one command (0.63.0, Poom 2026-09-25).
#
#   scripts/ui-check [OUT_DIR]
#
# Runs on the PC (Git Bash) with the A07 on adb. Installs the app from the
# newest successful CI run (the phone refuses APKs built on the PC), starts the
# walk INSIDE the running kiosk (debug broadcast TEST_UI_CHECK, app/src/debug/
# .../uicheck/UiWalk.kt) — every screen, no model in the loop — waits for it,
# checks the kiosk stayed LOCKED the whole time, pulls the pictures and results,
# and writes:
#   OUT_DIR/results.md      pass / fail per screen, with every issue
#   OUT_DIR/sheet.png       every screen on one sheet, its name under it
#   OUT_DIR/failed/*.png    the screens that did not pass, one picture each
#
#   SKIP_INSTALL=1    use what is installed
#   ONLY=home,calc    only the screens whose names start with those
#
# Not an instrumented test: `am instrument` force-stops the app, and on the A07
# that took the kiosk out of lock task for the whole walk.
#
# RULE (CLAUDE.md): every UI change runs this before it is reported, and the
# sheet goes with the report. A new screen is added to the walk.
set -u
export MSYS_NO_PATHCONV=1
cd "$(dirname "$0")/.." || exit 2

PKG=com.mammonrn.phoneaikiosk.debug
OUT=${1:-${TEMP:-/tmp}/kiosk-ui-check/$(date +%Y%m%d-%H%M%S)}
started=$(date +%s)

adb get-state >/dev/null 2>&1 || { echo "no phone on adb"; exit 2; }

if [ "${SKIP_INSTALL:-0}" != "1" ]; then
  run=$(gh run list -w "Build Android APK" -b main -s success -L 1 --json databaseId -q '.[0].databaseId')
  dl=$(mktemp -d)
  # A Windows path for gh.exe (MSYS_NO_PATHCONV above stops Git Bash converting it).
  command -v cygpath >/dev/null && dl=$(cygpath -m "$dl")
  echo "installing the app from CI run $run"
  gh run download "$run" -n phone-ai-kiosk-debug-apk -D "$dl/app" || exit 2
  apk=$(find "$dl/app" -name '*.apk' | head -1)
  [ -n "$apk" ] || { echo "no APK in the artifact"; exit 2; }
  adb install -r -t "$apk" | tail -1
  sleep 8        # the kiosk comes back and locks itself after an update
fi

adb shell dumpsys activity activities | grep -q "mLockTaskModeState=LOCKED" \
  || { echo "the kiosk is not LOCKED before the walk — not starting"; exit 2; }

echo "walking every screen…"
adb logcat -c
run_id=r$(date +%s)
adb shell am broadcast -a com.mammonrn.phoneaikiosk.TEST_UI_CHECK -p "$PKG" --es run "$run_id" ${ONLY:+--es only "$ONLY"} >/dev/null
end=$(( $(date +%s) + 600 ))
result=""
while [ "$(date +%s)" -lt "$end" ]; do
  result=$(adb logcat -d -s KioskUiCheck | grep -o -E "KioskUiCheck: (done|failed.*|busy) run=$run_id" | tail -1)
  [ -n "$result" ] && break
  sleep 5
done
case "$result" in *busy*) echo "another walk is still running on the phone — try again when it ends"; exit 2 ;; esac
echo "walk: ${result:-no answer in 10 minutes}"

lock_broke=0
if adb logcat -d | grep -q "updateLockTaskModeEnabled: false"; then
  echo "FAIL: lock task went OFF during the walk"
  lock_broke=1
fi
if adb shell dumpsys activity activities | grep -q "mLockTaskModeState=LOCKED"; then
  echo "kiosk: LOCKED"
else
  echo "FAIL: the kiosk is NOT LOCKED after the walk"
  lock_broke=1
fi

mkdir -p "$OUT"
adb pull "/sdcard/Android/data/$PKG/files/ui-check" "$OUT" >/dev/null || { echo "no results on the phone"; exit 1; }
PYTHONIOENCODING=utf-8 python tools/ui/report.py "$OUT/ui-check" "$OUT"
status=$?
[ "$lock_broke" = "1" ] && status=1
case "$result" in *done*) ;; *) status=1 ;; esac
echo "took $(( $(date +%s) - started )) s · $OUT"
exit $status
